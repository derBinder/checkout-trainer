{
  "name": "checkout-trainer",
  "version": "0.4.2",
  "private": true,
  "scripts": {
    "dev": "NEXT_EXIT_TIMEOUT_MS=5000 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "generate:cards": "tsx scripts/generate-cards.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed-admin": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-admin.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.16",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "ts-fsrs": "^6.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
